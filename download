              <th style={{ padding: '5px 8px', textAlign: 'left', fontSize: '8.5px', fontWeight: 700, color: '#6B7280', textTransform: 'uppercase', letterSpacing: '0.06em' }}>Stage</th>
            </tr>
          </thead>
          <tbody>
            {regionalData.map((row, idx) => (
              <tr
                key={idx}
                style={{ borderTop: '1px solid #E5E7EB', cursor: 'pointer' }}
                onMouseEnter={(e) => e.currentTarget.style.background = '#F8FAFF'}
                onMouseLeave={(e) => e.currentTarget.style.background = 'white'}
              >
                <td style={{ padding: '5px 8px', color: '#111827', fontWeight: 600 }}>{row.region}</td>
                <td style={{ padding: '5px 8px', color: '#007BFF', fontWeight: 600 }}>{row.tam}</td>
                <td style={{ padding: '5px 8px', color: '#28A745', fontWeight: 600 }}>{row.cagr}</td>
                <td style={{ padding: '5px 8px', color: '#374151' }}>{row.hhi}</td>
                <td style={{ padding: '5px 8px', color: '#374151' }}>{row.cr3}</td>
                <td style={{ padding: '5px 8px', color: '#374151' }}>{row.pl}</td>
                <td style={{ padding: '5px 8px' }}>
                  <span
                    className="px-2 py-0.5 rounded-full"
                    style={{
                      fontSize: '8px',
                      fontWeight: 700,
                      background: row.stage === 'Growth' ? '#DCFCE7' : row.stage === 'Mature' ? '#FEF9C3' : '#E0F2FE',
                      color: row.stage === 'Growth' ? '#166534' : row.stage === 'Mature' ? '#854D0E' : '#0369A1'
                    }}
                  >
                    {row.stage}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};

