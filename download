import { useState } from 'react';
import { ChevronDown } from 'lucide-react';
import ConsumptionCalendar from '../components/ConsumptionCalendar';

const CategoryIntel = ({ currency, currencyRates }) => {
  const [selectedCategory, setSelectedCategory] = useState('Health & Wellness');
  const [showCategoryDropdown, setShowCategoryDropdown] = useState(false);

  const categories = [
    'Food & Beverages',
    'Personal Care',
    'Health & Wellness',
    'Home Care',
    'Baby Care',
    'Pet Care'
  ];

  const convertCurrency = (value) => {
    const rate = currencyRates[currency]?.rate || 1;
    const symbol = currencyRates[currency]?.symbol || '₹';
    const converted = value * rate;
    return `${symbol}${converted.toFixed(converted < 10 ? 1 : 0)}`;
  };

  return (
    <div className="p-5">
      {/* Header with Category Selector */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold" style={{ color: '#111827' }}>
            Category Intelligence
          </h1>
          <p className="text-sm mt-1" style={{ color: '#6B7280' }}>
            Comprehensive market insights for {selectedCategory}
          </p>
        </div>

        <div className="relative">
          <button
            data-testid="category-selector"
            onClick={() => setShowCategoryDropdown(!showCategoryDropdown)}
            className="flex items-center gap-2 px-4 py-2 rounded-lg"
            style={{
              background: 'white',
              border: '1px solid #E5E7EB',
              fontSize: '11px',
              fontWeight: 600,
              color: '#111827',
              cursor: 'pointer'
            }}
          >
            {selectedCategory}
            <ChevronDown size={14} />
          </button>

          {showCategoryDropdown && (
            <div
              className="absolute right-0 mt-2 rounded-lg overflow-hidden"
              style={{
                background: 'white',
                border: '1px solid #E5E7EB',
                boxShadow: '0 4px 16px rgba(0,0,0,0.1)',
                minWidth: '180px',
                zIndex: 10
              }}
            >
              {categories.map(cat => (
                <div
                  key={cat}
                  data-testid={`category-option-${cat.toLowerCase().replace(/\s+/g, '-')}`}
                  onClick={() => {
                    setSelectedCategory(cat);
                    setShowCategoryDropdown(false);
                  }}
                  className="px-4 py-2 cursor-pointer"
                  style={{
                    fontSize: '11px',
                    color: selectedCategory === cat ? '#007BFF' : '#374151',
                    background: selectedCategory === cat ? 'rgba(0,123,255,0.07)' : 'white',
                    fontWeight: selectedCategory === cat ? 600 : 400
                  }}
                  onMouseEnter={(e) => {
                    if (selectedCategory !== cat) e.currentTarget.style.background = '#F8FAFF';
                  }}
                  onMouseLeave={(e) => {
                    if (selectedCategory !== cat) e.currentTarget.style.background = 'white';
                  }}
                >
                  {cat}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* All Content in Single Scrollable Page */}
      <div className="space-y-6">
        {/* Section 1: User Trends */}
        <Section title="User Trends" subtitle="Consumer behavior and emerging patterns">
          <UserTrendsContent currency={currency} convertCurrency={convertCurrency} />
        </Section>

        {/* Section 2: Demographics */}
        <Section title="Demographics" subtitle="Target audience breakdown">
          <DemographicsContent currency={currency} convertCurrency={convertCurrency} />
        </Section>

        {/* Section 3: Margins & Performance */}
        <Section title="Margins & Performance" subtitle="Financial metrics and benchmarks">
          <MarginsContent currency={currency} convertCurrency={convertCurrency} />
        </Section>

        {/* Section 4: TAM Analysis */}
        <Section title="TAM Analysis" subtitle="Total addressable market insights">
          <TAMContent currency={currency} convertCurrency={convertCurrency} />
        </Section>

        {/* Section 5: Consumption Patterns */}
        <Section title="Consumption Patterns" subtitle="Seasonal trends and buying behavior">
          <ConsumptionContent />
        </Section>
      </div>
    </div>
  );
};

