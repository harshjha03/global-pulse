import React, { useEffect, useState, createContext } from 'react';
import '@/App.css';
import { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';
import axios from 'axios';
import AuthScreen from './pages/AuthScreen';
import Dashboard from './pages/Dashboard';
import { Toaster } from 'sonner';

const BACKEND_URL = process.env.REACT_APP_BACKEND_URL;
const API = `${BACKEND_URL}/api`;

// Configure axios defaults
axios.defaults.baseURL = API;

// Auth context
export const AuthContext = createContext();

function App() {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [token, setToken] = useState(localStorage.getItem('token'));

  useEffect(() => {
    // Demo mode: auto-login with a demo user, no backend required
    const demoToken = 'demo-token';
    const demoUser = { id: 'demo', email: 'demo@globaldatapulse.com', name: 'Demo User' };
    localStorage.setItem('token', demoToken);
    setToken(demoToken);
    setUser(demoUser);
    setLoading(false);
  }, []);

  const login = (newToken, userData) => {
    localStorage.setItem('token', newToken);
    setToken(newToken);
    setUser(userData);
    axios.defaults.headers.common['Authorization'] = `Bearer ${newToken}`;
  };

  const logout = () => {
    localStorage.removeItem('token');
    setToken(null);
    setUser(null);
    delete axios.defaults.headers.common['Authorization'];
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-screen bg-[#F8FAFF]">
        <div className="text-[#007BFF] font-semibold">Loading...</div>
      </div>
    );
  }

  return (
    <div className="App">
      <AuthContext.Provider value={{ user, token, login, logout }}>
        <BrowserRouter>
          <Routes>
            <Route
              path="/auth"
              element={!token ? <AuthScreen /> : <Navigate to="/" replace />}
            />
            <Route
              path="/*"
              element={token ? <Dashboard /> : <Navigate to="/auth" replace />}
            />
          </Routes>
        </BrowserRouter>
        <Toaster position="top-right" />
      </AuthContext.Provider>
    </div>
  );
}

export default App;
